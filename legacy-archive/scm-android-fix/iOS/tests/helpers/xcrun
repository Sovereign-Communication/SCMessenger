#!/bin/bash
set -euo pipefail

if [ "$#" -eq 2 ] && [ "$1" = "xcdevice" ] && [ "$2" = "list" ]; then
  cat "$MOCK_XCDEVICE_JSON"
  exit 0
fi

if [ "$#" -eq 5 ] \
  && [ "$1" = "devicectl" ] \
  && [ "$2" = "list" ] \
  && [ "$3" = "devices" ] \
  && [ "$4" = "--json-output" ]; then
  cp "$MOCK_DEVICECTL_JSON" "$5"
  exit 0
fi

printf '%s\n' "unexpected xcrun invocation: $*" >&2
exit 64
