# Android Test Dockerfile
# Provides complete environment for running Android unit tests with UniFFI mocks
# Includes: Android SDK, NDK, Rust toolchain, Java 17, Gradle

FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install base dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    git \
    build-essential \
    libssl-dev \
    pkg-config \
    openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:$PATH"

# Install cargo-ndk for Android builds
RUN cargo install cargo-ndk

# Install Android SDK
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=$ANDROID_HOME
ENV PATH=$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH

RUN mkdir -p $ANDROID_HOME/cmdline-tools && \
    cd $ANDROID_HOME/cmdline-tools && \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip && \
    unzip -q commandlinetools-linux-9477386_latest.zip && \
    rm commandlinetools-linux-9477386_latest.zip && \
    mv cmdline-tools latest

# Accept Android SDK licenses
RUN yes | sdkmanager --licenses || true

# Install Android SDK components
RUN sdkmanager --update && \
    sdkmanager \
    "platform-tools" \
    "platforms;android-34" \
    "build-tools;34.0.0" \
    "ndk;26.1.10909125" \
    "cmake;3.22.1"

ENV ANDROID_NDK_HOME=$ANDROID_HOME/ndk/26.1.10909125

# NOTE: an earlier revision pre-fetched Robolectric android-all jars here. That
# was removed because it was wrong twice over:
#   1. All six pinned jar URLs 404'd, so the image build itself failed (wget
#      exit 8). The version strings were fabricated, not looked up.
#   2. Nothing in the project uses Robolectric. All 23 files under
#      android/app/src/test are plain JUnit -- zero @RunWith, zero @Config, zero
#      references to Robolectric. Robolectric never downloads android-all jars
#      unless RobolectricTestRunner actually runs, so it cannot have been the
#      cause of the :app:testDebugUnitTest hang.
# The unused org.robolectric dependency has been dropped from
# android/app/build.gradle. The real cause of the hang is still UNKNOWN; see the
# testLogging block there, which prints each test as it starts so the last line
# before the timeout identifies the culprit.

# Set working directory
WORKDIR /workspace

# Copy workspace files
COPY . .

# Add the Android Rust targets -- AFTER the COPY, and from /workspace.
#
# rustup honours rust-toolchain.toml from the directory that contains it, so
# the toolchain this image actually compiles with is the repository's PINNED
# one (1.99.0), not the `stable` that the rustup installer above set as
# default. Adding the targets before this COPY put them in `stable`, where
# nothing ever looks: Gradle runs `cargo ndk --target aarch64-linux-android`
# from /workspace, under the pinned toolchain, which had no Android std.
# That is how the image built successfully and the job still failed:
#   error[E0463]: can't find crate for `core`
#     = note: the `aarch64-linux-android` target may not be installed
# The compiler's advice (`rustup target add aarch64-linux-android`) is
# misleading here: run before the COPY it appears to succeed and changes
# nothing.
#
# Doing it after the COPY means rustup resolves whatever the pin says, so a
# future channel bump cannot silently reintroduce this. This regressed in
# 87932c08 (the toolchain pin); the image had not been correct since.
RUN rustup target add \
    aarch64-linux-android \
    armv7-linux-androideabi \
    i686-linux-android \
    x86_64-linux-android

# Fail the BUILD, not a 90-minute test run, if the pinned toolchain cannot
# provide these targets.
RUN rustup target list --installed | grep -q aarch64-linux-android
# Set environment for Android builds
ENV RUSTFLAGS="-C link-arg=-Wl,-z,max-page-size=16384"

# Default command runs Android unit tests
CMD ["bash", "-c", "cd android && ./gradlew test --no-daemon --info"]
